{
  "name": "ai-debator",
  "version": "1.0.0",
  "description": "AI-powered debate platform with voice integration",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "clean": "rm -rf node_modules client/node_modules server/node_modules package-lock.json"
  },
  "keywords": ["ai", "debate", "voice", "speech-recognition"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
